# Rails — environment template. Copy to .env (gitignored); never commit real secrets.
# Network blocks are tagged [testnet] / [mainnet]; testnet is active by default.

# ── Server ──
SECRET=                                # 32-byte secret (AES + HMAC): openssl rand -hex 32
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000                       # ignored when the platform injects PORT
SERVER_TIMEZONE=Africa/Lagos
ALLOWED_HOSTS=*
TRUSTED_PROXIES=*                       # CIDRs gin trusts for X-Forwarded-For; * = trust all (PaaS edge)
ENVIRONMENT=local                      # local | staging | production
HOST_DOMAIN=http://localhost:8000
SENTRY_DSN=

# ── Auth / JWT ──
JWT_SIGNING_KEY=                       # falls back to SECRET if empty; set in prod (openssl rand -hex 64)
JWT_ISSUER=rails.zoracle
JWT_AUDIENCE=rails.zoracle.clients
JWT_ACCESS_LIFESPAN=15                 # minutes
JWT_REFRESH_LIFESPAN=10080             # minutes (7d)
PASSWORD_RESET_LIFESPAN=15             # minutes
EMAIL_VERIFICATION_LIFESPAN=1440       # minutes (24h)
HMAC_TIMESTAMP_AGE=5                   # minutes
ADMIN_API_TOKEN=                       # empty disables admin endpoints
GOOGLE_OAUTH_CLIENT_ID=

# ── Database (Postgres) ──
# Preferred: a full connection string (Neon/Railway/Heroku give you one, with
# sslmode=require baked in). When set, it overrides the DB_* parts below.
DATABASE_URL=                          # e.g. postgresql://user:pass@host/db?sslmode=require
# DB_URL is an accepted alias, consulted only when DATABASE_URL is empty. Set
# one or the other, not both.
DB_URL=
# Discrete parts — used only when DATABASE_URL is empty (local dev).
DB_NAME=rails
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
SSL_MODE=disable                       # local default; managed DBs need require (use DATABASE_URL)

# ── Redis ──
# Preferred: full connection string (Railway/Upstash). Overrides the parts below.
REDIS_URL=                              # e.g. redis://default:pass@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0



# ── Email (Resend / SendGrid / Mailgun) ──
EMAIL_PROVIDER=resend                  # resend | sendgrid | mailgun
EMAIL_DOMAIN=api.sendgrid.com
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=Rails <no-reply@usezoracle.com>
CARD_RECOVERY_SENDGRID_TEMPLATE=



# ── Banknote recognition ──
# Without a key there is no recognition, and the cash pledge routes are not
# registered at all -- a pledge nobody looked at would mean crediting people
# for photographs.
ANTHROPIC_API_KEY=                      # secret
# Which model counts the notes. Choose from measured accuracy against real
# photographs, not intuition.
VISION_MODEL=claude-haiku-4-5

# ── Settlement ──
# How often money the ledger says is owed is pushed out to banks. Until this
# runs, merchants accrue balances that nothing pays.
SETTLEMENT_INTERVAL_SECONDS=20
# How often the naira leg of a card tap -- what the cardholder paid from a
# naira balance -- is paid to the merchant out of the cardholder's own wallet
# at the bank rail (docs/naira-settlement.md). Needs a rail whose wallets
# hold their own balance (Fintava); with none, legs queue until one is set.
NGN_SETTLEMENT_INTERVAL_SECONDS=10

# ── Cash pledges ──
# How often float locked against an expired handover is released. Until it
# runs, an agent's capital is committed to a trader who never came and cannot
# serve anybody else.
CASH_SWEEP_INTERVAL_SECONDS=30

# ── Currency conversion (FX) ──
# Rate providers, as JSON. Declared here rather than one variable per provider
# so adding a source needs no code change. {base}, {quote} and {amount} are
# substituted into the URL; `path` is a dotted path to the number in the
# response; `invert` flips a provider that publishes base-per-quote.
#
# With no sources configured, conversion endpoints are not registered at all.
# There is deliberately no default and no seeded rate: quoting from a stale
# number means offering a price nobody can honour.
FX_SOURCES=

# Spread per pair, in basis points, as PAIR:BPS pairs. A pair with no spread
# cannot be quoted -- a default here would be the platform guessing at its own
# margin. e.g. USD/NGN:50,NGN/USD:50
FX_SPREADS=

# How far a provider may sit from the median before its answer is discarded,
# as a fraction. 0.05 = 5%. A provider printing a wildly different number is
# broken, and averaging it in spreads its error to every customer.
FX_MAX_DEVIATION=0.05

# ── Card payments ──
# The platform's cut of a card payment, in basis points of the amount. Taken
# out of what the merchant receives, never added on top.
CARD_FEE_BPS=50

# ── Equity market (Freedom) ──
# Both optional. Set both and every naira tap is reported to the market
# (merchant fee → buyback → shares for the cardholder), merchants can list
# their business, and cardholders can see their holdings. Leave either empty
# and the feature is off: taps charge as before, nothing is queued, and the
# equity endpoints answer 404 saying so. See docs/equity.md.
FREEDOM_BASE_URL=                      # origin only, e.g. https://api.freedom.example (no /v1/rail)
FREEDOM_RAIL_TOKEN=                    # the RAIL_TOKEN configured on Freedom's exchanged
EQUITY_OUTBOX_INTERVAL_SECONDS=5       # how often queued taps are delivered

# ── Order lifecycle ──
ORDER_FULFILLMENT_VALIDITY=10          # minutes
RECEIVE_ADDRESS_VALIDITY=30            # minutes
ORDER_REQUEST_VALIDITY=120             # seconds
BUCKET_QUEUE_REBUILD_INTERVAL=1        # minutes
REFUND_CANCELLATION_COUNT=3
PERCENT_DEVIATION_FROM_EXTERNAL_RATE=1
PERCENT_DEVIATION_FROM_MARKET_RATE=0.1
NETWORK_FEE=0.05

# ── Sui ──
SUI_AGGREGATOR_PRIVATE_KEY=            # secret: Ed25519 seed, hex, no 0x (same key all networks)
SUI_AGGREGATOR_CAP_ID=                 # per-deployment
SUI_GATEWAY_PACKAGE_ID=                # per-deployment
SUI_GATEWAY_OBJECT_ID=                 # per-deployment
SUI_GRPC_TOKEN=                        # optional x-token for the gRPC/WS provider
# NOTE: SUI_RPC_URL must NOT be a public fullnode. JSON-RPC is deprecated there
# (-32601 "Method not found" on every call) and this codebase's Sui SDK is
# JSON-RPC. Use a provider that still serves it, e.g.
#   SUI_RPC_URL=https://rpc.ankr.com/sui/<token>
# SUI_WS_URL / SUI_GRPC_URL are unaffected (gRPC is the supported transport).
SUI_RPC_URL=https://fullnode.testnet.sui.io:443     # [testnet] DEPRECATED — see note above
SUI_WS_URL=wss://fullnode.testnet.sui.io:443        # [testnet]
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443    # [testnet]
# SUI_RPC_URL=https://fullnode.mainnet.sui.io:443   # [mainnet]
# SUI_WS_URL=wss://fullnode.mainnet.sui.io:443      # [mainnet]
# SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443  # [mainnet]

# ── Sui gas station (Shinami) ──
SHINAMI_GAS_BASE_URL=                   # from Shinami dashboard
SHINAMI_GAS_API_KEY=                    # network-specific key (separate for testnet / mainnet)




# ── Aggregator RSA keypair (encrypts recipient bank details carried on-chain) ──
AGGREGATOR_PUBLIC_KEY=                  # secret
AGGREGATOR_PRIVATE_KEY=                 # secret


# ── Platform (auto-injected; rarely set manually) ──
# PORT=                                # listen port; set by Railway/Heroku, overrides SERVER_PORT
# ENV_FILE_PATH=.env                   # alternate config filename for startup

# ── Custody (REQUIRED) ──
# AES-256 key that seals every custodied EVM private key at rest.
# The service refuses to start without it: `openssl rand -hex 32`.
#
# There is deliberately no default. A previous revision carried a literal key
# in utils/crypto/wallet.go that was used whenever this was unset OR malformed,
# so every stored private key was encrypted under a value in the repository.
# Rotating this key requires re-encrypting existing users.encrypted_private_key
# rows under the new key -- it is not a config-only change.
WALLET_MASTER_KEY=

# ── Base (EVM) ──
BASE_RPC_URL=https://sepolia.base.org   # [testnet] https://mainnet.base.org for [mainnet]
BASE_CHAIN_ID=84532                     # 84532 Base Sepolia | 8453 Base mainnet
BASE_USDC_CONTRACT=                     # per-network USDC address
BASE_USDC_DECIMALS=6
BASE_GATEWAY_CONTRACT=                  # settlement Gateway, per deployment
BASE_AGGREGATOR_ADDRESS=                # receives bridged USDC; must match BASE_SIGNER_KEY
BASE_SIGNER_KEY=                        # secret: hot wallet private key, hex
BASE_SENDER_FEE_BPS=50                  # platform fee charged on top of an order
BASE_NATIVE_LOW_THRESHOLD_WEI=10000000000000000   # 0.01 ETH — gas balance alert floor

# ── Coinbase Developer Platform (Smart Accounts) ──
# When all three secrets are set, every NEW deposit address is a CDP Smart
# Account: the key is generated and held in CDP's TEE and never enters this
# process, and a paymaster pays the gas to sweep it. Addresses already issued
# from BASE_DEPOSIT_SEED are untouched and keep sweeping by permit.
#
# All three are required together. Two of three is refused at boot rather
# than falling back silently -- the operator meant to turn this on.
CDP_API_KEY_ID=                         # from the CDP portal
CDP_API_KEY_SECRET=                     # secret: base64 Ed25519 key from the CDP portal
CDP_WALLET_SECRET=                      # secret: authorises account creation and sends
# The paymaster is what makes it gasless. Required when CDP is on: a smart
# account without one must hold ETH to act, which is the thing this removes.
CDP_PAYMASTER_URL=                      # e.g. https://api.developer.coinbase.com/rpc/v1/base/<token>
CDP_BASE_URL=https://api.cdp.coinbase.com/platform

# ── Gas ──
# On-chain work costs ETH from the treasury, and that cost is recorded exactly
# (gas_used x effective_gas_price, from the receipt) for every transaction.
#
# Most of the cost is sweeps. Deposit addresses hold no ETH and nothing funds
# them, so a sweep is pulled with an EIP-2612 permit -- signed off-chain for
# free by the deposit address, submitted and paid for by the treasury. That is
# why only one wallet ever needs gas.
#
# How many automated top-ups a gas wallet may receive in 24 hours. Replenishment
# with no rate limit is a drain loop: force spend, trigger refill, repeat. 0
# disables automated refills entirely, which is the default -- moving real money
# on a timer should be a decision, not an inherited setting.
GAS_MAX_REFILLS_PER_DAY=0

# Master seed for per-user USDC deposit addresses (BIP-32, m/44'/60'/0'/0/n).
# REQUIRED when deposits are enabled: `openssl rand -hex 32`.
#
# There is no default. A fixed fallback would put every deployment's deposits
# under one key -- the same failure as generating a key per user, concentrated.
# Everything is derived from this, so it is the only thing that needs backing
# up; losing the database does not lose anybody's money, and losing this does.
BASE_DEPOSIT_SEED=                      # secret

# The treasury wallet's private key. Deposits are swept into it and USDC
# withdrawals are paid from it. Without it deposits are still credited, but
# nothing can be swept and nothing can leave -- which the service says at boot
# rather than at the moment somebody withdraws.
BASE_TREASURY_KEY=                      # secret

# Blocks before a deposit is credited. Base is an L2 that can reorg, and a
# credited deposit that later never happened is money already spent.
BASE_CONFIRMATIONS=12

# Where the deposit watcher starts when it has no recorded position. Set to a
# recent block: scanning from genesis is a request no provider will serve.
BASE_START_BLOCK=0
BASE_POLL_INTERVAL_SECONDS=15

# ── Bridging ──
LIFI_BASE_URL=https://li.quest/v1
LIFI_API_KEY=                           # optional; raises rate limits
CCTP_FALLBACK_ENABLED=true              # fall back to LiFi when CCTP cannot quote
CCTP_IRIS_URL=                          # Circle attestation service, per network

# ── Settlement aggregator ──
SETTLEMENT_API_URL=https://api.paycrest.io
SETTLEMENT_SENDER_API_KEY_ID=           # secret
SETTLEMENT_POLL_INTERVAL_SECONDS=30
SETTLEMENT_PUBKEY_CACHE_TTL_SECONDS=3600

# ── BaaS: Safe Haven MFB ──
SAFEHAVEN_BASE_URL=https://api.safehavenmfb.com
SAFEHAVEN_CLIENT_ID=                    # secret
SAFEHAVEN_PRIVATE_KEY=                  # secret
SAFEHAVEN_ISSUER=
SAFEHAVEN_AUDIENCE=
SAFEHAVEN_DEBIT_ACCOUNT_NUMBER=         # the float account payouts debit
SAFEHAVEN_WEBHOOK_SECRET=               # secret; unset means inbound events cannot be verified
SAFEHAVEN_MAX_TRANSFER_NGN=1000000

# ── BaaS: Fintava ──
FINTAVA_BASE_URL=https://live.fintavapay.com/api/dev
FINTAVA_API_KEY=                        # secret
FINTAVA_WEBHOOK_SECRET=                 # secret; unset means inbound events cannot be verified

# ── KYC: identity verification ──
# Verification runs on Fintava's compliance endpoints (FINTAVA_API_KEY above):
# GET /compliance/verify/bvn matches a BVN against the bank record (tier 1),
# POST /compliance/verify/bvn/selfie matches a face to it (tier 2). Both answer
# synchronously, so there is no callback URL and no separate secret to set.
# With FINTAVA_API_KEY unset the /v1/kyc routes are not registered at all.

# ── Client applications ──
PWA_BASE_URL=https://tapp.zoracle.com       # cardholder PWA; every /c/:token redirect targets it
CHECKOUT_BASE_URL=https://checkout.zoracle.com

# ── Workers ──
# Exactly one process may run background jobs against a database. Set true on
# every additional API instance (canary builds, separately scaled HTTP nodes).
DISABLE_BACKGROUND_JOBS=false
